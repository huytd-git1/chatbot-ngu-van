{
  "name": "co-duong-day-van-de-thuong",
  "version": "1.0.0",
  "description": "Chatbot RAG hỗ trợ học Ngữ văn - Cô Dương dạy văn dễ thương",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build": "npm run build:frontend && npm run build:backend",
    "test": "npm test --prefix backend",
    "test:load": "docker run --rm -i -v \"${PWD}/tests/k6:/scripts\" grafana/k6 run /scripts/stress-test.js",
    "test:load:smoke": "docker run --rm -i -v \"${PWD}/tests/k6:/scripts\" grafana/k6 run /scripts/smoke-test.js",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "npm run dev:backend",
    "migrate": "npm run migrate --prefix backend",
    "seed": "npm run seed --prefix backend",
    "start": "node backend/dist/index.js",
    "create-admin": "npm run create-admin --prefix backend",
    "create-test-teacher": "npm run create-test-teacher --prefix backend"
  },
  "keywords": [
    "rag",
    "gemini",
    "file-search",
    "ngu-van",
    "education"
  ],
  "author": "Antigravity Engineer",
  "license": "ISC"
}
