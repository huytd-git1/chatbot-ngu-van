# ==============================================================================
# CÔ DƯƠNG DẠY VĂN DỄ THƯƠNG - CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Sao chép tệp này thành .env và điền các giá trị thực tế trước khi chạy.
# ==============================================================================

# 1. Cổng máy chủ & Môi trường
PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:4000

# 2. Khóa bí mật phiên làm việc (Session Secret)
# Tối thiểu 32 ký tự ngẫu nhiên bảo mật cao để ký Cookie phiên làm việc
SESSION_SECRET=co-duong-day-van-super-secret-key-32-chars-long!

# 3. Cơ sở dữ liệu PostgreSQL
# - Để chạy thử nghiệm nhanh zero-dependency không cần cài PostgreSQL: đặt DATABASE_URL=memory
# - Trên Production hoặc Render: postgresql://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=memory

# 4. Google Gemini API & Gemini File Search
# Lấy API Key chính thức miễn phí hoặc trả phí tại: https://aistudio.google.com/app/apikey
# Nếu để trống, hệ thống tự động kích hoạt bộ giả lập Mock RAG thông minh để chạy kiểm thử local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 5. Cấu hình Hạn mức & Trần an toàn toàn hệ thống
DAILY_STUDENT_QUOTA=20
SYSTEM_HARD_CAP=5000
